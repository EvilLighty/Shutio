<Window x:Class="SnippingTool.Capture.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SnippingTool.Capture"
        Title="Snip"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True">
    <Window.Resources>
        <Style x:Key="OverlayToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayCloseButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <local:SelectionSurface x:Name="Surface" />

        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <Border x:Name="LoupeBorder" Visibility="Collapsed" Width="108" Height="108"
                    CornerRadius="10" BorderThickness="1" BorderBrush="#B0FFFFFF" Background="#EE101114">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.6" />
                </Border.Effect>
                <Grid>
                    <Image x:Name="LoupeImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="4" />
                    <Rectangle Width="1" Height="100" Fill="#CCFF3B30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Rectangle Height="1" Width="100" Fill="#CCFF3B30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="6" Margin="4" />
                </Grid>
            </Border>
            <Border x:Name="LoupeLabel" Visibility="Collapsed" Background="#EE1C1C1E" CornerRadius="5" Padding="7,3"
                    BorderBrush="#33FFFFFF" BorderThickness="1">
                <TextBlock x:Name="LoupeCoords" Foreground="White" FontSize="11" />
            </Border>
        </Canvas>

        <Border x:Name="ToolbarPanel" VerticalAlignment="Top" HorizontalAlignment="Left"
                Background="#F21B1C1F" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="14"
                Padding="6" Margin="0,16,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="ToolRect" Style="{StaticResource OverlayToolToggle}" ToolTip="Rectangular snip (1)">
                    <Path Data="M4,6 H20 V18 H4 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.7" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" />
                </ToggleButton>
                <ToggleButton x:Name="ToolFreeform" Style="{StaticResource OverlayToolToggle}" ToolTip="Freeform snip (2)">
                    <Path Data="M3,17 C5,8 12,3 20,6 C19,13 12,20 3,17 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.6" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" />
                </ToggleButton>
                <ToggleButton x:Name="ToolWindow" Style="{StaticResource OverlayToolToggle}" ToolTip="Window snip (3)">
                    <Path Data="M3,5 H21 V19 H3 Z M3,9 H21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.6" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" />
                </ToggleButton>
                <ToggleButton x:Name="ToolFullscreen" Style="{StaticResource OverlayToolToggle}" ToolTip="Full desktop (4)">
                    <Path Data="M3,8 V3 H8 M16,3 H21 V8 M21,16 V21 H16 M8,21 H3 V16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.7" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" />
                </ToggleButton>
                <ToggleButton x:Name="ToolMonitor" Style="{StaticResource OverlayToolToggle}" ToolTip="Single display (5)">
                    <Path Data="M3,5 H21 V17 H3 Z M8,21 H16 M12,17 V21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.6" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" />
                </ToggleButton>
                <Border Style="{StaticResource ThinSeparator}" Background="#33FFFFFF" Margin="7,4" />
                <Button x:Name="CloseButton" Style="{StaticResource OverlayCloseButton}" ToolTip="Cancel (Esc)">
                    <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="HintPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26"
                Background="#E61B1C1F" BorderBrush="#2FFFFFFF" BorderThickness="1" CornerRadius="999" Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HintText" Foreground="#F2FFFFFF" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="   ·   Esc to cancel" Foreground="#A6FFFFFF" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
