<Window x:Class="SnippingTool.Capture.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture delay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ShowActivated="True">
    <Border Background="#F21B1C1F" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="999"
            Padding="18,11" Margin="14,10,14,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.55" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="17" Background="#33FFFFFF" VerticalAlignment="Center">
                <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,4,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Taking snip in" Foreground="#A6FFFFFF" FontSize="11" />
                <TextBlock x:Name="CountText" Text="3 seconds" Foreground="White" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
            <Button x:Name="CancelButton" Width="34" Height="34" Margin="10,0,0,0" Background="Transparent"
                    Cursor="Hand" ToolTip="Cancel (Esc)" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="White" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" />
            </Button>
        </StackPanel>
    </Border>
</Window>
