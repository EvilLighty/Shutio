<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Shutio</AssemblyName>
    <RootNamespace>SnippingTool</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>2.1.0</Version>
    <FileVersion>2.1.0.0</FileVersion>
    <Product>Shutio</Product>
    <Company>SalsaNOW Edition</Company>
    <Description>Portable Windows capture, annotation, OCR and screen-recording tool (SalsaNOW edition)</Description>
    <Copyright>Portable utility</Copyright>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>

    <!-- Distribute as a single-file, self-contained app: the whole .NET + WPF
         runtime is folded into Shutio.exe (the ~249 loose runtime DLLs go away).
         ffmpeg.exe, Assets\ and the user's Data\ stay loose. Publish-only: regular
         dotnet build / self-test are unaffected. (Matches installer/updater builds.) -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WindowsDesktop SDK adds these globally; they create constant type ambiguity
         with WPF types (Point, Color, Brush, Button, Application...). -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <None Update="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
