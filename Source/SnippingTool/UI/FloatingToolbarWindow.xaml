<Window x:Class="SnippingTool.UI.FloatingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snip toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#F21B1C1F" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="14"
            Padding="7" Margin="12,10,12,16" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.5" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Border Width="26" Height="30" Background="Transparent" Cursor="SizeAll" ToolTip="Drag toolbar">
                <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#80FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ToggleButton x:Name="TbRect" Style="{StaticResource FloatingToolButton}" ToolTip="Rectangular snip (Ctrl+Shift+S)">
                <Path Data="M4,6 H20 V18 H4 Z" Width="20" Height="20" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Fill="Transparent" />
            </ToggleButton>
            <ToggleButton x:Name="TbFreeform" Style="{StaticResource FloatingToolButton}" ToolTip="Freeform snip (Ctrl+Shift+A)">
                <Path Data="M3,17 C5,8 12,3 20,6 C19,13 12,20 3,17 Z" Width="20" Height="20" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6" Fill="Transparent" />
            </ToggleButton>
            <ToggleButton x:Name="TbWindow" Style="{StaticResource FloatingToolButton}" ToolTip="Window snip (Ctrl+Shift+W)">
                <Path Data="M3,5 H21 V19 H3 Z M3,9 H21" Width="20" Height="20" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6" Fill="Transparent" />
            </ToggleButton>
            <ToggleButton x:Name="TbFull" Style="{StaticResource FloatingToolButton}" ToolTip="Full desktop (Ctrl+Shift+F)">
                <Path Data="M3,8 V3 H8 M16,3 H21 V8 M21,16 V21 H16 M8,21 H3 V16" Width="20" Height="20" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Fill="Transparent" />
            </ToggleButton>
            <ToggleButton x:Name="TbMonitor" Style="{StaticResource FloatingToolButton}" ToolTip="Single display (Ctrl+Shift+M)">
                <Path Data="M3,5 H21 V17 H3 Z M8,21 H16 M12,17 V21" Width="20" Height="20" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6" Fill="Transparent" />
            </ToggleButton>
            <Border Style="{StaticResource ThinSeparator}" Background="#33FFFFFF" Height="20" Margin="5,0" />
            <Button x:Name="TbHistory" Style="{StaticResource FloatingTextButton}" Content="History" ToolTip="Open capture history" />
            <Button x:Name="TbClose" Style="{StaticResource FloatingIconButton}" ToolTip="Hide floating toolbar">
                <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="#D9FFFFFF" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform" />
            </Button>
        </StackPanel>
    </Border>
</Window>
