<Window x:Class="SnippingTool.UI.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shutio"
        Style="{StaticResource ModernWindow}"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="470"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleLabel" Text="Shutio" Margin="18,0,0,0" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Style="{StaticResource TitleBarCloseButton}" HorizontalAlignment="Right" Width="42" Height="32"
                        Margin="0,0,5,0" Click="Cancel_Click" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
            </Grid>

            <Grid Grid.Row="1" Margin="24,4,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBubble" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"
                        VerticalAlignment="Top" HorizontalAlignment="Left">
                    <TextBlock x:Name="IconGlyph" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="17"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="HeadingText" Text="Notice" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="MessageText" Text="" Margin="0,7,0,0" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="19" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
                <StackPanel x:Name="ButtonsHost" Orientation="Horizontal" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
