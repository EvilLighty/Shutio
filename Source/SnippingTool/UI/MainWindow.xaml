<Window x:Class="SnippingTool.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:SnippingTool.Editor"
        xmlns:editing="clr-namespace:SnippingTool.Editing"
        Title="Shutio"
        Style="{StaticResource ModernWindow}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Width="1060" Height="720" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- The glass surface: a rounded, translucent panel over the desktop. The inner cards stay
         opaque for readability; the body between them is what lets the desktop show through. -->
    <Border x:Name="GlassRoot" CornerRadius="14" BorderThickness="1"
            BorderBrush="{DynamicResource WindowBorderBrush}" Background="{DynamicResource AppBackgroundBrush}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: identity (left) · tab strip + window buttons (right) -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Shutio" FontSize="12" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource ThinSeparator}" Height="14" Margin="12,0" />
                    <Ellipse x:Name="HotkeyDot" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="HotkeyStateText" Text="Shortcuts ready" FontSize="11" Margin="6,0,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <RadioButton x:Name="TabScreenshot" Style="{StaticResource TabPill}" GroupName="MainTab" Content="Screenshot"
                                 Margin="0,0,5,0" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabVideo" Style="{StaticResource TabPill}" GroupName="MainTab" Content="Video editing"
                                 Margin="0,0,5,0" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabRecording" Style="{StaticResource TabPill}" GroupName="MainTab" Content="Recording"
                                 Margin="0,0,12,0" Checked="Tab_Checked" />
                    <Button x:Name="SettingsGear" Style="{StaticResource IconButton}" Click="SettingsGear_Click"
                            ToolTip="Settings" Margin="0,0,2,0">
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="15" />
                    </Button>
                    <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" ToolTip="Switch light or dark appearance">
                        <TextBlock x:Name="ThemeGlyph" Text="&#xE706;" Style="{StaticResource IconGlyph}" FontSize="15" />
                    </Button>
                    <Button x:Name="TrayButton" Style="{StaticResource IconButton}" ToolTip="Keep running in the notification area">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource TitleBarMinButton}" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button Style="{StaticResource TitleBarMaxButton}" x:Name="MaximizeButton" Click="Maximize_Click" ToolTip="Maximize" />
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="Close_Click" ToolTip="Close" Margin="0,0,2,0" />
                </StackPanel>
            </Grid>

            <!-- Content: three panels, one visible at a time -->
            <Grid Grid.Row="1">

                <!-- ===================== SCREENSHOT ===================== -->
                <Grid x:Name="ScreenshotTab">
                <ScrollViewer x:Name="PanelScreenshot" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,10">
                    <StackPanel Margin="26,14,26,20" MaxWidth="1000">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Capture &amp; edit." FontFamily="{StaticResource AppFontDisplay}" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock Text="Snip a region, a window, or the whole desktop, then edit it right here — no pop-ups."
                                           Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap" MaxWidth="540" />
                            </StackPanel>
                            <Button x:Name="NewSnipButton" Style="{StaticResource PrimaryButton}" Padding="19,10"
                                    HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center" Margin="18,0,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="13"
                                               Foreground="{DynamicResource AccentForegroundBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="New snip" Margin="7,0,0,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentForegroundBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Capture modes -->
                        <UniformGrid Columns="5" Margin="0,18,0,0">
                            <Button x:Name="ModeRect" Style="{StaticResource ModeCardButton}" Margin="0,0,7,0" Tag="Rectangle">
                                <StackPanel>
                                    <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                                        <Path Data="M4,6 H20 V18 H4 Z" Width="20" Height="20" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" Fill="Transparent" />
                                    </Border>
                                    <TextBlock Text="Rectangle" Style="{StaticResource H3}" Margin="0,10,0,0" />
                                    <TextBlock x:Name="RectShortcut" Text="Ctrl + Shift + S" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ModeFreeform" Style="{StaticResource ModeCardButton}" Margin="0,0,7,0" Tag="Freeform">
                                <StackPanel>
                                    <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                                        <Path Data="M3,17 C5,8 12,3 20,6 C19,13 12,20 3,17 Z" Width="20" Height="20" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Fill="Transparent" />
                                    </Border>
                                    <TextBlock Text="Freeform" Style="{StaticResource H3}" Margin="0,10,0,0" />
                                    <TextBlock x:Name="FreeformShortcut" Text="Ctrl + Shift + A" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ModeWindow" Style="{StaticResource ModeCardButton}" Margin="0,0,7,0" Tag="Window">
                                <StackPanel>
                                    <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                                        <Path Data="M3,5 H21 V19 H3 Z M3,9 H21" Width="20" Height="20" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Fill="Transparent" />
                                    </Border>
                                    <TextBlock Text="Window" Style="{StaticResource H3}" Margin="0,10,0,0" />
                                    <TextBlock x:Name="WindowShortcut" Text="Ctrl + Shift + W" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ModeFullscreen" Style="{StaticResource ModeCardButton}" Margin="0,0,7,0" Tag="Fullscreen">
                                <StackPanel>
                                    <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                                        <Path Data="M3,8 V3 H8 M16,3 H21 V8 M21,16 V21 H16 M8,21 H3 V16" Width="20" Height="20" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" Fill="Transparent" />
                                    </Border>
                                    <TextBlock Text="Full desktop" Style="{StaticResource H3}" Margin="0,10,0,0" />
                                    <TextBlock x:Name="FullShortcut" Text="Ctrl + Shift + F" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ModeMonitor" Style="{StaticResource ModeCardButton}" Tag="Monitor">
                                <StackPanel>
                                    <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                                        <Path Data="M3,5 H21 V17 H3 Z M8,21 H16 M12,17 V21" Width="20" Height="20" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Fill="Transparent" />
                                    </Border>
                                    <TextBlock Text="Display" Style="{StaticResource H3}" Margin="0,10,0,0" />
                                    <TextBlock x:Name="MonitorShortcut" Text="Ctrl + Shift + M" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- After capture + delay -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="After capture" Style="{StaticResource H3}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <CheckBox x:Name="AutoCopyToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                                        <TextBlock Text="Copy to clipboard" FontSize="12.5" Margin="9,0,22,0" VerticalAlignment="Center" />
                                        <CheckBox x:Name="AutoSaveToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                                        <TextBlock Text="Save automatically" FontSize="12.5" Margin="9,0,22,0" VerticalAlignment="Center" />
                                        <CheckBox x:Name="OpenEditorToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                                        <TextBlock Text="Open editor" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                    <TextBlock Text="Delay" Style="{StaticResource H3}" HorizontalAlignment="Right" />
                                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,7,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton x:Name="Delay0" Style="{StaticResource SegmentToggle}" Content="0 s" Tag="0" />
                                            <ToggleButton x:Name="Delay3" Style="{StaticResource SegmentToggle}" Content="3 s" Tag="3" />
                                            <ToggleButton x:Name="Delay5" Style="{StaticResource SegmentToggle}" Content="5 s" Tag="5" />
                                            <ToggleButton x:Name="Delay10" Style="{StaticResource SegmentToggle}" Content="10 s" Tag="10" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Recent snips -->
                        <Grid Margin="0,20,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Recent snips" Style="{StaticResource H2}" />
                                <TextBlock x:Name="RecentCountText" Text="0" Style="{StaticResource Tiny}" Margin="9,3,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="ViewHistoryButton" Style="{StaticResource LinkButton}" Content="View all" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Style="{StaticResource SectionCard}" Padding="8" MinHeight="72">
                            <StackPanel x:Name="RecentHost" />
                        </Border>

                        <!-- Shortcuts / footer -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0" Padding="18,14"
                                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Work from anywhere" Style="{StaticResource H3}" />
                                    <TextBlock x:Name="HotkeySummaryText" Text="Ctrl + Shift + S for a rectangular snip"
                                               Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TrayHintText" Text="The app can keep running in the notification area so shortcuts work while it is minimized."
                                               Style="{StaticResource Tiny}" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="620" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <Button x:Name="HistoryButton" Style="{StaticResource GhostButton}" Content="History" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="FooterText" Style="{StaticResource Tiny}" Margin="2,14,0,0"
                                   Text="Portable" ToolTip="Where this app keeps its data" />
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <!-- ===================== VIDEO EDITING (Shutio Cut timeline, ≤6 tracks) ===================== -->
                <editing:CutPane x:Name="CutPaneHost" Visibility="Collapsed" />

                <!-- ===================== RECORDING ===================== -->
                <ScrollViewer x:Name="PanelRecording" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26,14,26,20" MaxWidth="1000">
                        <StackPanel>
                            <TextBlock Text="Record your screen" FontFamily="{StaticResource AppFontDisplay}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Capture a full desktop, a window, or a region — with optional webcam, microphone, and separate audio for easy editing."
                                       Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap" MaxWidth="740" />
                        </StackPanel>

                        <!-- Source -->
                        <TextBlock Text="What to record" Style="{StaticResource Tiny}" Margin="2,18,0,8" />
                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="RecSourceFull" Style="{StaticResource SegmentToggle}" Content="Full desktop" />
                                <ToggleButton x:Name="RecSourceMonitor" Style="{StaticResource SegmentToggle}" Content="Single display" />
                                <ToggleButton x:Name="RecSourceWindow" Style="{StaticResource SegmentToggle}" Content="Window" />
                                <ToggleButton x:Name="RecSourceRegion" Style="{StaticResource SegmentToggle}" Content="Region" />
                            </StackPanel>
                        </Border>

                        <!-- Frame rate + Resolution -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Frame rate" Style="{StaticResource Tiny}" Margin="2,0,0,8" />
                                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton x:Name="RecFps15" Style="{StaticResource SegmentToggle}" Content="15" />
                                        <ToggleButton x:Name="RecFps30" Style="{StaticResource SegmentToggle}" Content="30" />
                                        <ToggleButton x:Name="RecFps60" Style="{StaticResource SegmentToggle}" Content="60" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                <TextBlock Text="Resolution" Style="{StaticResource Tiny}" Margin="2,0,0,8" />
                                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton x:Name="RecResNative" Style="{StaticResource SegmentToggle}" Content="Native" />
                                        <ToggleButton x:Name="RecRes1080" Style="{StaticResource SegmentToggle}" Content="1080p" />
                                        <ToggleButton x:Name="RecRes720" Style="{StaticResource SegmentToggle}" Content="720p" />
                                        <ToggleButton x:Name="RecRes540" Style="{StaticResource SegmentToggle}" Content="540p" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Audio -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Audio" Style="{StaticResource H3}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="RecAudioToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Record microphone audio" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel x:Name="RecMicPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Microphone" Style="{StaticResource Tiny}" Margin="0,0,0,6" />
                                    <ComboBox x:Name="RecMicCombo" Style="{StaticResource ModernComboBox}" MinHeight="34"
                                              HorizontalAlignment="Left" MinWidth="320" />
                                </StackPanel>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="RecSeparateToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Save audio separately (easier to edit later)" FontSize="13" />
                                        <TextBlock Style="{StaticResource Tiny}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="Records a video-only MP4 plus a lossless .wav. In the editor they stay independent tracks." />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="RecCursorToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Show mouse cursor" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Webcam picture-in-picture -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="RecWebcamToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Webcam (picture-in-picture)" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="Choose webcam" Style="{StaticResource Tiny}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="RecCamCombo" Style="{StaticResource ModernComboBox}" MinHeight="34" Margin="0,0,0,12" />
                                    </StackPanel>
                                    <StackPanel x:Name="RecCamPanel" Visibility="Collapsed">
                                        <TextBlock Text="Size" Style="{StaticResource Tiny}" Margin="0,0,0,6" />
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton x:Name="RecCamSizeS" Style="{StaticResource SegmentToggle}" Content="S" />
                                                <ToggleButton x:Name="RecCamSizeM" Style="{StaticResource SegmentToggle}" Content="M" />
                                                <ToggleButton x:Name="RecCamSizeL" Style="{StaticResource SegmentToggle}" Content="L" />
                                            </StackPanel>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <CheckBox x:Name="RecCamMirror" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Mirror (self view)" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="RecPreview" Width="300" Height="200" Background="{DynamicResource EditorCanvasBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock Text="preview · drag the cam" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                                        <Border x:Name="RecPipBox" Width="120" Height="80" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="#664CC2FF" BorderBrush="White" BorderThickness="2" CornerRadius="8" Cursor="SizeAll"
                                                MouseLeftButtonDown="RecPipBox_MouseDown" MouseMove="RecPipBox_MouseMove" MouseLeftButtonUp="RecPipBox_MouseUp">
                                            <TextBlock Text="cam" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Engine notice -->
                        <Border x:Name="RecEngineNotice" Style="{StaticResource SectionCard}" Padding="12" Margin="0,16,0,0"
                                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RecEngineIcon" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RecEngineText" Text="MP4 · H.264 encoder ready" Margin="9,0,0,0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Record -->
                        <Grid Margin="0,16,0,0">
                            <TextBlock x:Name="RecStatusText" Text="Ready" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <Button x:Name="RecRecordButton" Style="{StaticResource PrimaryButton}" Padding="20,10" HorizontalAlignment="Right" Click="RecRecord_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="#FF453A" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecRecordLabel" Text="Record" Margin="8,0,0,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentForegroundBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Snackbar hint -->
            <Border x:Name="HintBar" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
                    Background="{DynamicResource ToastBrush}" CornerRadius="9" Padding="15,9" Visibility="Collapsed">
                <TextBlock x:Name="HintText" Foreground="White" FontSize="12" />
            </Border>
        </Grid>
    </Border>
</Window>
