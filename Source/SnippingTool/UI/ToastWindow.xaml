<Window x:Class="SnippingTool.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#F21E1F22" BorderBrush="#3DFFFFFF" BorderThickness="1" CornerRadius="12"
            Padding="14,12" Margin="16,12,16,18" MaxWidth="420">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.55" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ThumbBorder" Width="76" Height="50" CornerRadius="7" Background="#22FFFFFF"
                    VerticalAlignment="Center" Margin="0,0,12,0" ClipToBounds="True" Visibility="Collapsed">
                <Image x:Name="ThumbImage" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="180">
                <TextBlock x:Name="MessageText" Text="" Foreground="White" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" />
                <Button x:Name="ActionButton" Style="{StaticResource FloatingTextButton}" HorizontalAlignment="Left"
                        Padding="0,5,0,0" FontSize="11.5" Foreground="#8FD8FF" Visibility="Collapsed" Cursor="Hand" />
            </StackPanel>
            <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource FloatingIconButton}" Width="28" Height="28"
                    VerticalAlignment="Top" Margin="8,-4,-4,0" ToolTip="Dismiss">
                <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="#B0FFFFFF" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" />
            </Button>
        </Grid>
    </Border>
</Window>
