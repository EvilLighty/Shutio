<Window x:Class="SnippingTool.UI.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update"
        Style="{StaticResource ModernWindow}"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="440"
        SizeToContent="Height"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border CornerRadius="12" Margin="10">
        <StackPanel Margin="22,20,22,20">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="HeadingText" Text="Update" Style="{StaticResource H2}" Margin="12,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource TitleBarCloseButton}" HorizontalAlignment="Right" Margin="-6,-6,0,0"
                        Click="CloseButton_Click" Content="&#xE8BB;" ToolTip="Close" />
            </Grid>

            <TextBlock x:Name="StatusText" Text="Checking GitHub…" FontSize="14" Margin="0,16,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText" Text="" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}" Content="Open Settings" MinWidth="108"
                        Margin="0,0,8,0" Visibility="Collapsed" />
                <Button x:Name="LaterButton" Style="{StaticResource GhostButton}" Content="Later" MinWidth="88" Margin="0,0,8,0" />
                <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="Update now" MinWidth="118" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
