<Window x:Class="SnippingTool.Recording.WebcamPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Webcam"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Width="352" Height="264"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Root_MouseLeftButtonDown"
        MouseMove="Root_MouseMove"
        MouseLeftButtonUp="Root_MouseLeftButtonUp">
    <Border Background="#F218191C" BorderBrush="#3DFFFFFF" BorderThickness="1" CornerRadius="14" Margin="12,10,12,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="14,11,10,7">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#FF453A" VerticalAlignment="Center" />
                    <TextBlock Text="Webcam · live" Foreground="#A6FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" />
                </StackPanel>
                <Button x:Name="CloseButton" Width="24" Height="24" HorizontalAlignment="Right" Background="#22FFFFFF" Cursor="Hand"
                        ToolTip="Hide the preview (the recording continues)" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="White" StrokeThickness="1.4" Width="8" Height="8" />
                </Button>
            </Grid>
            <Grid Margin="10,0,10,10" Width="320" Height="180">
                <Border CornerRadius="9" Background="#1A000000" ClipToBounds="True">
                    <Image x:Name="CamImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <Border x:Name="StatusPanel" CornerRadius="9" Background="#E6101114">
                    <TextBlock x:Name="StatusText" Text="Waiting for the camera…" Foreground="#B3FFFFFF" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="300" Margin="14" />
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</Window>
