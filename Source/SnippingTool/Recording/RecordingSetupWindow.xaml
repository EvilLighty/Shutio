<Window x:Class="SnippingTool.Recording.RecordingSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record screen"
        Style="{StaticResource ModernWindow}"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Record screen" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource TitleBarCloseButton}" HorizontalAlignment="Right" Width="42" Height="32"
                        Margin="0,0,5,0" Click="Cancel_Click" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="24,4,24,20">
                <TextBlock Text="Record your screen" Style="{StaticResource H2}" />
                <TextBlock Text="Capture a full desktop, a window, or a region to an MP4 video." Style="{StaticResource Caption}"
                           Margin="0,4,0,20" TextWrapping="Wrap" />

                <TextBlock Text="What to record" Style="{StaticResource Tiny}" Margin="2,0,0,7" />
                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="SourceFullscreen" Content="Full desktop" Style="{StaticResource SegmentToggle}" IsChecked="True" />
                        <ToggleButton x:Name="SourceMonitor" Content="Single display" Style="{StaticResource SegmentToggle}" />
                        <ToggleButton x:Name="SourceWindow" Content="Window" Style="{StaticResource SegmentToggle}" />
                        <ToggleButton x:Name="SourceRegion" Content="Region" Style="{StaticResource SegmentToggle}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Frame rate" Style="{StaticResource Tiny}" Margin="2,20,0,7" />
                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="Fps10" Content="10 fps" Style="{StaticResource SegmentToggle}" />
                        <ToggleButton x:Name="Fps15" Content="15 fps" Style="{StaticResource SegmentToggle}" IsChecked="True" />
                        <ToggleButton x:Name="Fps24" Content="24 fps" Style="{StaticResource SegmentToggle}" />
                        <ToggleButton x:Name="Fps30" Content="30 fps" Style="{StaticResource SegmentToggle}" />
                        <ToggleButton x:Name="Fps60" Content="60 fps" Style="{StaticResource SegmentToggle}" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="CursorCheck" Style="{StaticResource ToggleSwitch}" IsChecked="True" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Show mouse cursor" FontSize="13" />
                            <TextBlock Text="Draws the cursor into the recording." Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="AudioCheck" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Record microphone audio" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="MicPickerPanel" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Text="Microphone" Style="{StaticResource Tiny}" Margin="0,0,0,6" />
                        <ComboBox x:Name="MicCombo" Style="{StaticResource ModernComboBox}" MinHeight="34"
                                 HorizontalAlignment="Left" MinWidth="280" />
                    </StackPanel>
                </StackPanel>

                <Border x:Name="EngineNotice" Style="{StaticResource SectionCard}" Padding="12" Margin="0,18,0,0"
                        Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="EngineIcon" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="EngineText" Text="MP4 · H.264 encoder ready" Margin="9,0,0,0" FontSize="12"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" MinWidth="88" Click="Cancel_Click" IsCancel="True" />
                <Button x:Name="StartButton" Content="Start recording" Style="{StaticResource PrimaryButton}" MinWidth="140"
                        Margin="8,0,0,0" Click="Start_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
