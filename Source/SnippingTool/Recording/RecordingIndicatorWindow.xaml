<Window x:Class="SnippingTool.Recording.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#F218191C" BorderBrush="#3DFFFFFF" BorderThickness="1" CornerRadius="999"
            Padding="12,8" Margin="12,10,12,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.5" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Grid Width="18" Height="18" VerticalAlignment="Center">
                <Ellipse x:Name="Pulse" Width="12" Height="12" Fill="#FF453A" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </Grid>
            <StackPanel Margin="9,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="Recording" Foreground="#A6FFFFFF" FontSize="10" FontWeight="SemiBold" />
                <TextBlock x:Name="TimerText" Text="00:00" Foreground="White" FontSize="14" FontWeight="SemiBold"
                           FontFamily="{StaticResource MonoFont}" />
            </StackPanel>
            <Button x:Name="StopButton" Width="36" Height="36" Margin="8,0,0,0" Background="#22FFFFFF" Cursor="Hand"
                    ToolTip="Stop recording" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="White" />
            </Button>
        </StackPanel>
    </Border>
</Window>
