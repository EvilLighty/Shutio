<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBFBFD" Offset="0" />
        <GradientStop Color="#F1F3F8" Offset="0.55" />
        <GradientStop Color="#EAEDF3" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EDEFF3" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E3E6EC" />
    <SolidColorBrush x:Key="CardBrush" Color="#FCFCFD" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E4EA" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#C9CDD5" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17191D" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6069" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A909A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005BA1" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4F0FA" />
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#BBD9F2" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FCE9E7" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#12000000" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#10000000" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />
    <SolidColorBrush x:Key="CheckerLightBrush" Color="#F4F4F4" />
    <SolidColorBrush x:Key="CheckerDarkBrush" Color="#D9D9D9" />
    <SolidColorBrush x:Key="EditorCanvasBrush" Color="#DFE2E8" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#33000000" />
    <SolidColorBrush x:Key="ToastBrush" Color="#F2202020" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#D4D7DD" />
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F2F2F2" Geometry="M0,0 H16 V16 H0 Z" />
                <GeometryDrawing Brush="#DCDCDC" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
