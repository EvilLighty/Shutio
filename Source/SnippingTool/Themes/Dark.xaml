<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#24262A" Offset="0" />
        <GradientStop Color="#1E2023" Offset="0.55" />
        <GradientStop Color="#18191C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2D31" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#323438" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#3A3D42" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#43464C" />
    <SolidColorBrush x:Key="CardBrush" Color="#2E3034" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3C3F45" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#50545C" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8BCC4" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8C919A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6DD0FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3AA9E0" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#08131A" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#163749" />
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#245A78" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#44232A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />
    <SolidColorBrush x:Key="CheckerLightBrush" Color="#3A3C40" />
    <SolidColorBrush x:Key="CheckerDarkBrush" Color="#303236" />
    <SolidColorBrush x:Key="EditorCanvasBrush" Color="#151619" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#66000000" />
    <SolidColorBrush x:Key="ToastBrush" Color="#F233353A" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#4A4D54" />
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#35373B" Geometry="M0,0 H16 V16 H0 Z" />
                <GeometryDrawing Brush="#2C2E32" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
